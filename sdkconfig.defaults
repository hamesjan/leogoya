# XIAO ESP32S3 Sense: 8 MB flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# OTA slots + "storage" slot for the reference image / calibration
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# console over the USB-C port; UART pins stay free for the motion board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# planning runs long CPU-bound loops in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_BROWNOUT_DET=y
